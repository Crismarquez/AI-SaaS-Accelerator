# Example environment variables for Accelerator

# General settings
APP_ENV=development
APP_SECRET_KEY=your-secret-key

# Database settings
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# CORS settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase Admin SDK
# Provide either a file path to the service account JSON or the JSON content
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Payments service
PAYMENT_PROVIDER_API_KEY=your-payment-api-key

# Notifications service
WHATSAPP_API_KEY=your-whatsapp-api-key
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Assistants service
OPENAI_API_KEY=your-openai-api-key
